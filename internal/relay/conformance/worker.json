{
  "about": "The Worker answers 404 with an empty body to everything but the two requests, and a bad room tag exactly as a room refuses a key: on /v1/ws a challenge then 1008, on /v1/cmd 404.",
  "layer": "worker",
  "steps": [
    {"http": {"as": "h1", "method": "GET", "path": "/"}},
    {"expect": {"as": "h1", "status": 404}},
    {"http": {"as": "h2", "method": "GET", "path": "/health"}},
    {"expect": {"as": "h2", "status": 404}},
    {"http": {"as": "h3", "method": "GET", "path": "/v1/ws", "room": "main"}},
    {"expect": {"as": "h3", "status": 404}},
    {"http": {"as": "h4", "method": "GET", "path": "/v1/ws", "upgrade": true}},
    {"expect": {"as": "h4", "status": 404}},
    {"http": {"as": "h5", "method": "GET", "path": "/v1/ws", "header": "not-a-room", "upgrade": true}},
    {"expect": {"as": "h5", "status": 404}},
    {"http": {"as": "h6", "method": "GET", "path": "/v1/ws?x=1", "room": "main", "upgrade": true}},
    {"expect": {"as": "h6", "status": 404}},
    {"http": {"as": "h7", "method": "POST", "path": "/v1/ws", "room": "main"}},
    {"expect": {"as": "h7", "status": 404}},
    {"http": {"as": "h8", "method": "GET", "path": "/v1/cmd", "room": "main"}},
    {"expect": {"as": "h8", "status": 404}},
    {"http": {"as": "h9", "method": "PUT", "path": "/v1/cmd", "room": "main"}},
    {"expect": {"as": "h9", "status": 404}},
    {"http": {"as": "h10", "method": "POST", "path": "/v1/cmd"}},
    {"expect": {"as": "h10", "status": 404}},
    {"post": {"as": "h11", "room": "badtag", "request": {"key": "watch1", "nonce": "n1"}}},
    {"expect": {"as": "h11", "status": 404}},
    {"connect": {"as": "b1", "room": "badtag"}},
    {"expect": {"as": "b1", "frame": {"t": "challenge", "nonce": "*"}}},
    {"send": {"as": "b1", "auth": {"role": "mac", "key": "mac", "provision": "valid"}}},
    {"expect": {"as": "b1", "close": 1008}},
    {"connect": {"as": "b2", "room": "badtag"}},
    {"expect": {"as": "b2", "frame": {"t": "challenge", "nonce": "*"}}},
    {"advance_ms": 5001},
    {"expect": {"as": "b2", "close": 1008}}
  ]
}
