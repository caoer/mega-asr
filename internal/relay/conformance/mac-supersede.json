{
  "about": "A newer authenticated Mac socket supersedes the old one (4001) and the phone sockets close 1012 before the new Mac's ok; an unauthenticated socket supersedes nothing.",
  "layer": "room",
  "setup": {"mac": "mac", "room": "main", "key": "mac", "devices": [{"role": "phone", "key": "phone1"}]},
  "steps": [
    {"connect": {"as": "p1", "room": "main"}},
    {"expect": {"as": "p1", "frame": {"t": "challenge", "nonce": "*"}}},
    {"send": {"as": "p1", "auth": {"role": "phone", "key": "phone1"}}},
    {"expect": {"as": "mac", "frame": {"t": "peer", "sid": {"$capture": "s1"}, "role": "phone", "key": "@phone1", "up": true, "oneshot": false}}},
    {"send": {"as": "mac", "text": {"t": "peer_ack", "sid": "$s1"}}},
    {"expect": {"as": "p1", "frame": {"t": "ok", "sid": "$s1", "peer": true}}},

    {"connect": {"as": "u1", "room": "main"}},
    {"expect": {"as": "u1", "frame": {"t": "challenge", "nonce": "*"}}},
    {"expect": {"as": "mac", "nothing": true}},
    {"expect": {"as": "p1", "nothing": true}},

    {"connect": {"as": "macB", "room": "main"}},
    {"expect": {"as": "macB", "frame": {"t": "challenge", "nonce": "*"}}},
    {"send": {"as": "macB", "auth": {"role": "mac", "key": "mac"}}},
    {"expect": {"as": "mac", "close": 4001}},
    {"expect": {"as": "p1", "close": 1012}},
    {"expect": {"as": "macB", "frame": {"t": "ok", "peers": []}}},
    {"expect": {"as": "macB", "nothing": true}}
  ]
}
