{
  "about": "With no Mac connected a phone gets ok with peer false and its frames are dropped; a Mac that connects later finds it in ok.peers and hears when it goes.",
  "layer": "room",
  "setup": {"mac": "mac", "room": "main", "key": "mac", "devices": [{"role": "phone", "key": "phone1"}]},
  "steps": [
    {"close": {"as": "mac", "code": 1000}},
    {"connect": {"as": "p1", "room": "main"}},
    {"expect": {"as": "p1", "frame": {"t": "challenge", "nonce": "*"}}},
    {"send": {"as": "p1", "auth": {"role": "phone", "key": "phone1"}}},
    {"expect": {"as": "p1", "frame": {"t": "ok", "sid": {"$capture": "s1"}, "peer": false}}},
    {"send": {"as": "p1", "binary": {"hex": "0102"}}},
    {"expect": {"as": "p1", "nothing": true}},
    {"connect": {"as": "mac2", "room": "main"}},
    {"expect": {"as": "mac2", "frame": {"t": "challenge", "nonce": "*"}}},
    {"send": {"as": "mac2", "auth": {"role": "mac", "key": "mac"}}},
    {"expect": {"as": "mac2", "frame": {"t": "ok", "peers": [{"sid": "$s1", "role": "phone", "key": "@phone1"}]}}},
    {"close": {"as": "p1", "code": 1000}},
    {"expect": {"as": "mac2", "frame": {"t": "peer", "sid": "$s1", "role": "phone", "key": "@phone1", "up": false, "oneshot": false}}}
  ]
}
