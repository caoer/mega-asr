{
  "about": "Every refused request is 404 with an empty body and reaches no Mac: an unknown key, a bad signature, a phone or Mac key, a stale or future ts, a short or oversize body, a room without the key. The nonce a refused request carried is still free.",
  "layer": "room",
  "setup": {"mac": "mac", "room": "main", "key": "mac", "devices": [{"role": "phone", "key": "phone1"}, {"role": "watch", "key": "watch1"}]},
  "steps": [
    {"post": {"as": "r1", "room": "main", "request": {"key": "stranger", "nonce": "n1"}}},
    {"expect": {"as": "r1", "status": 404}},
    {"post": {"as": "r2", "room": "main", "request": {"key": "watch1", "signer": "stranger", "nonce": "n1"}}},
    {"expect": {"as": "r2", "status": 404}},
    {"post": {"as": "r3", "room": "main", "request": {"key": "phone1", "nonce": "n1"}}},
    {"expect": {"as": "r3", "status": 404}},
    {"post": {"as": "r4", "room": "main", "request": {"key": "mac", "nonce": "n1"}}},
    {"expect": {"as": "r4", "status": 404}},
    {"post": {"as": "r5", "room": "main", "request": {"key": "watch1", "nonce": "n1", "ts": -60001}}},
    {"expect": {"as": "r5", "status": 404}},
    {"post": {"as": "r6", "room": "main", "request": {"key": "watch1", "nonce": "n1", "ts": 60001}}},
    {"expect": {"as": "r6", "status": 404}},
    {"post": {"as": "r7", "room": "main", "body_len": 264}},
    {"expect": {"as": "r7", "status": 404}},
    {"post": {"as": "r8", "room": "main", "body_len": 16385}},
    {"expect": {"as": "r8", "status": 404}},
    {"post": {"as": "r9", "room": "main", "request": {"key": "watch1", "nonce": "n1", "ct_len": 16233}}},
    {"expect": {"as": "r9", "status": 404}},
    {"post": {"as": "r10", "room": "other", "request": {"key": "watch1", "nonce": "n1"}}},
    {"expect": {"as": "r10", "status": 404}},
    {"expect": {"as": "mac", "nothing": true}},
    {"post": {"as": "ok", "room": "main", "request": {"key": "watch1", "nonce": "n1", "ts": -60000}}},
    {"expect": {"as": "mac", "frame": {"t": "peer", "sid": {"$capture": "s1"}, "role": "watch", "key": "@watch1", "up": true, "oneshot": true}}},
    {"send": {"as": "mac", "text": {"t": "peer_ack", "sid": "$s1"}}},
    {"expect": {"as": "mac", "binary": {"sid": "$s1", "body_of": "ok"}}},
    {"send": {"as": "mac", "binary": {"sid": "$s1", "hex": "aa"}}},
    {"expect": {"as": "ok", "status": 200, "hex": "aa"}}
  ]
}
