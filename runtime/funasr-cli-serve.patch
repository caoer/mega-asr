+// funasr_vad_run with the model loaded from gguf_path for this one call, on the CPU.
+inline bool funasr_vad_segments(const std::string& gguf_path, const std::vector<float>& wav,
+                                int max_seg_ms, std::vector<std::pair<int,int>>& segs, int nthreads=8){
+  funasr_vad_model m; std::string why;
+  if(!funasr_vad_load(gguf_path,m,nullptr,why,nthreads)){fprintf(stderr,"vad: %s\n",why.c_str());segs.clear();return false;}
